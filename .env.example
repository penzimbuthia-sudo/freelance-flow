# Server only. Never put these in VITE_ variables.
GOOGLE_API_KEY=
# GOOGLE_API_KEY takes precedence if both are set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox business account's merchant ID, NOT the client ID or buyer ID.
PAYPAL_MERCHANT_ID=
PUBLIC_BASE_URL=http://localhost:5173
# Server-only PostgreSQL URI. Blank keeps local SQLite; never use VITE_DATABASE_URL.
# Copy from the EXISTING Neon project's production branch Connect dialog.
# Preserve sslmode=require&channel_binding=require. Never paste it into chat.
DATABASE_URL=
# Set FF_ENV_FILE=.env.local in the launching shell to select that file explicitly.
# Relative paths are resolved from the repository root.
DATABASE_PATH=instance/freelance-flow.sqlite3
# Allowed HTTP Host headers. Keep local defaults unless deploying public payment pages.
APP_HOSTS=localhost,127.0.0.1,[::1]
# Hosted Render mode: set APP_ENV=production, use PostgreSQL + public HTTPS origin,
# and set APP_HOSTS to that exact hostname. Local defaults stay loopback-only.
APP_ENV=local
# Required server-only login secrets in hosted mode. Never put a raw password here.
SECRET_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
